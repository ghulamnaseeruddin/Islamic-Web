# Copy this file to ".env.local" and fill in your own values.
# Never commit ".env.local" to GitHub.

# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# The "anon" key (or the new "publishable" key). Safe to use in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# The "service_role" key. SECRET. Only used on the server to delete an account.
# Never put NEXT_PUBLIC_ in front of it.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---- AI for "Ask Noor" (free tiers) ----
# Get a Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Get a Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional. OpenAI has no free API tier, so leave empty unless you pay for one.
OPENAI_API_KEY=

# Which provider to try first. Comma separated. Default: groq,gemini
AI_PROVIDER_ORDER=groq,gemini
# How many Ask Noor questions each user may ask per day (protects free limits)
AI_DAILY_LIMIT=25

# Optional: force specific model names (comma separated, tried in order).
# Model names change over time. If a model stops working, check the provider's
# model list and put a current name here.
# GROQ_MODEL_SMART=llama-3.3-70b-versatile
# GROQ_MODEL_FAST=llama-3.1-8b-instant
# GEMINI_MODEL_SMART=gemini-2.5-flash
# GEMINI_MODEL_FAST=gemini-2.5-flash-lite

# Optional: shown on the Privacy page
NEXT_PUBLIC_CONTACT_EMAIL=
